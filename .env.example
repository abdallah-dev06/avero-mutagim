# ───────── Database (PostgreSQL 15+) ─────────
# Local dev: run `npm run db:local` then use the URL below.
DATABASE_URL="postgresql://vetrina:vetrina_local_dev@localhost:5433/vetrina"

# ───────── Site ─────────
# Public canonical URL (used for SEO, sitemap, Open Graph and tracking links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── Image storage ─────────
# STORAGE_DRIVER=local  → files written to ./public/uploads (development / single VPS only)
# STORAGE_DRIVER=s3     → any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DO Spaces)
STORAGE_DRIVER="local"
S3_ENDPOINT=""                 # e.g. https://<accountid>.r2.cloudflarestorage.com (leave empty for AWS)
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""          # public CDN URL for the bucket, e.g. https://images.vetrina.ps

# ───────── Initial admin (used ONLY by `npm run admin:create`) ─────────
# Prefer passing these interactively; never commit real values.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Vetrina Admin"

# ───────── WhatsApp Business Cloud API (optional, merchant-owned) ─────────
# Leave empty to use manual wa.me drafts only. Automatic messages are disabled unless ALL are set.
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_APP_SECRET=""
WHATSAPP_CLOUD_VERIFY_TOKEN=""
WHATSAPP_CLOUD_API_VERSION="v21.0"
WHATSAPP_CLOUD_TEMPLATE_NAME="order_status_update"   # must be approved in Meta Business Manager
WHATSAPP_CLOUD_TEMPLATE_LANG="ar"
